{
	"schemaVersion": 1,
	"id": "subtlyd",
	"version": "${version}",
	"name": "Subtly Dungeons",
	"description": "Adds \"canon\" features from Dungeons and Legends. Focuses on vanilla parity, exploration, and making the game feel like a cohesive sequel",
	"authors": [
		"Meander Studios"
	],
	"contact": {
        "issues": "https://github.com/Meander-Studios/SubtlyDungeons/issues",
		"sources": "https://github.com/Meander-Studios/SubtlyDungeons"
	},
	"license": " LGPL-3.0-only",
	"icon": "assets/subtlyd/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.meander.subtlyd.server.InitializerSD"
		],
		"fabric-datagen": [
			"net.meander.subtlyd.data.DataGeneratorSD"
		],
      "client": [
        "net.meander.subtlyd.client.ClientInitializerSD"
      ]
	},
	"mixins": [
		"subtlyd.mixins.json"
	],
    "accessWidener": "subtlyd.classtweaker",
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~26.3-",
		"java": ">=25",
		"fabric-api": "*"
	}
}