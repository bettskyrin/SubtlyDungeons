{
	"schemaVersion": 1,
	"id": "subtlyd",
	"version": "${version}",
	"name": "Subtly Dungeons",
	"description": "Adds \"canon\" features from Dungeons and Legends. Focuses on vanilla parity, exploration, and making the game feel like a cohesive sequel",
	"authors": [
		"Kyrin Betts, Aldin Besic"
	],
	"contact": {
        "issues": "https://github.com/bettskyrin/SubtlyDungeons/issues",
		"sources": "https://github.com/bettskyrin/SubtlyDungeons"
	},
	"license": " LGPL-3.0-only",
	"icon": "assets/subtlyd/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.kr1s1s.subtlyd.util.InitializerSD"
		],
		"fabric-datagen": [
			"com.kr1s1s.subtlyd.util.DataGeneratorSD"
		],
      "client": [
		  "com.kr1s1s.subtlyd.util.ClientInitializerSD"
      ]
	},
	"mixins": [
		"subtlyd.mixins.json"
	],
    "accessWidener": "subtlyd.classtweaker",
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": "~26.1-",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}